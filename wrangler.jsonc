{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "secure-labx-training",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secure-labx-training",
      "database_id": "10ee1378-f9c4-4fb3-93a5-48e021c035e8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "secure-labx-training-files"
    }
  ]
}
